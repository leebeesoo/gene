{"id":"tongyeong","name":"통영","sido":"경상남도","sigungu":"통영시","checked":"2026-10","dishes":[{"n":"도다리쑥국","k":"도다리","ing":["도다리"],"m":"3~4","ms":"dish","season":"봄(3~4월) 도다리 살이 오르고 섬 쑥이 막 올라옴","intro":"봄 도다리에 해쑥을 넣어 맑게 끓인 국으로, 통영 사람들은 이걸 먹어야 봄이 왔다고 해요.","src":"https://www.utour.go.kr/00056/00062/00119.web","tips":[{"s":"쑥국","tip":"살 오른 도다리에 갓 뜯은 햇쑥을 넣고 맑게 끓이면 봄 향이 그릇 가득해요."}],"ri":[3,9,11,15,24,27,30,31,32,33]},{"n":"멍게비빔밥","k":"멍게","ing":["멍게"],"m":"3~6","ms":"dish","season":"봄(3~6월) 멍게 향이 가장 진함","intro":"잘게 썬 멍게를 김가루, 참기름이랑 비벼 먹는 한 그릇으로 바다 향이 입안 가득 퍼져요.","src":"https://www.utour.go.kr/00152/00063/00394.web","tips":[{"s":"비빔밥","tip":"잘게 썬 멍게를 밥에 올리고 김가루, 참기름 넣어 비비면 향긋한 한 그릇이 돼요."}],"ri":[2,5,6,10,11,12,13,14]},{"n":"멸치무침","k":"멸치","ing":["멸치"],"m":"3~5","ms":"ing","tips":[{"s":"무침","tip":"봄 생멸치를 채소랑 새콤달콤 초장에 무쳐 먹으면 고소함이 확 살아나요."}],"ri":[2,4,5,7,15,16,18,19]},{"n":"물메기탕","k":"물메기","ing":["물메기"],"m":"11~2","ms":"dish","season":"겨울(11~2월) 물메기가 제철","intro":"물메기를 양념 없이 맑게 끓여서 국물이 시원하고 살이 부드러워요. 겨울 해장국으로 최고예요.","src":"https://www.utour.go.kr/00056/00062/00119.web","tips":[{"s":"탕","tip":"무랑 대파만 넣고 맑게 끓인 물메기탕은 살이 부드럽고 국물이 시원해요."}],"ri":[3,9,11,27,32,33]},{"n":"굴전","k":"굴","ing":["굴"],"m":"11~3","ms":"ing","tips":[{"s":"전","tip":"굴에 달걀옷을 입혀 노릇하게 부치면 겉은 고소하고 속은 촉촉해요."}],"ri":[0,2,4,7,8]},{"n":"굴회","k":"굴","ing":["굴"],"m":"11~3","ms":"ing","tips":[{"s":"회","tip":"갓 깐 생굴을 초고추장에 살짝 찍어 먹으면 바다 향이 입안에 확 퍼져요."}],"ri":[0,2,8,9]},{"n":"붕장어구이","k":"붕장어","ing":["붕장어"],"m":"6~8","ms":"ing","tips":[{"s":"구이","tip":"양념이나 소금을 발라 숯불에 구우면 기름이 자글자글 올라 고소해요."}],"ri":[22,23,24,25]},{"n":"하모회","k":"갯장어","ing":["갯장어"],"m":"7~9","ms":"dish","season":"여름(7~9월) 장마 뒤 갯장어 살이 오름","intro":"잔뼈를 촘촘히 칼집 낸 갯장어 회로, 쫄깃하고 담백해서 여름 보양식으로 찾아요.","src":"https://www.utour.go.kr/00056/00062/00119.web","tips":[{"s":"회","tip":"잔뼈를 촘촘히 칼집 낸 하모회는 쫄깃하면서도 담백해서 여름 별미예요."}],"ri":[26,27,28,29]},{"n":"멸치쌈밥","k":"멸치","ing":["멸치"],"m":"3~5","ms":"ing","tips":[{"s":"쌈밥","tip":"멸치를 자작하게 조려 상추에 밥이랑 싸 먹으면 짭짤하고 든든해요."}],"ri":[15,16,17]},{"n":"전어회","k":"전어","ing":["전어"],"m":"9~10","ms":"dish","season":"가을(9~10월) 전어에 기름이 오름","intro":"가을 전어를 뼈째 썰어 먹는 세꼬시 회예요. 씹을수록 고소한 맛이 올라와요.","src":"https://www.utour.go.kr/00056/00062/00119.web","tips":[{"s":"회","tip":"가을 전어를 뼈째 잘게 썬 세꼬시로 먹으면 씹을수록 고소해요."}],"ri":[10,26,28]},{"n":"굴밥","k":"굴","ing":["굴"],"m":"11~3","ms":"dish","season":"겨울(11~3월) 굴이 알차게 참","intro":"굴을 얹어 지은 밥에 양념간장을 비벼 먹는 통영 굴 요리의 대표 메뉴예요.","src":"https://www.korea.kr/news/policyNewsView.do?newsId=148958947","tips":[{"s":"굴밥","tip":"굴을 얹어 지은 밥에 양념간장을 슥슥 비벼 먹으면 고소하고 든든해요."}],"ri":[4,5]},{"n":"붕장어탕","k":"붕장어","ing":["붕장어"],"m":"6~8","ms":"ing","tips":[{"s":"탕","tip":"장어를 푹 고아 시래기랑 끓인 장어탕은 진하고 구수해서 몸이 든든해져요."}],"ri":[20,24]},{"n":"갯장어샤브샤브","k":"갯장어","ing":["갯장어"],"m":"7~9","ms":"ing","tips":[{"s":"샤브샤브","tip":"뜨거운 육수에 살짝 담갔다 건지면 꽃처럼 피어나서 보는 맛, 먹는 맛이 다 있어요."}],"ri":[27]},{"n":"굴국","k":"굴","ing":["굴"],"m":"11~3","ms":"ing","ri":[3]},{"n":"굴국밥","k":"굴","ing":["굴"],"m":"11~3","ms":"ing","tips":[{"s":"국밥","tip":"굴을 듬뿍 넣고 시원하게 끓인 국에 밥 말아 먹으면 겨울 아침 해장으로 딱이에요."}],"ri":[7]},{"n":"굴요리","k":"굴","ing":["굴"],"m":"11~3","ms":"ing","ri":[1]},{"n":"굴해장국","k":"굴","ing":["굴"],"m":"11~3","ms":"ing","ri":[6]},{"n":"멍게젓갈","k":"멍게","ing":["멍게"],"m":"3~6","ms":"ing","tips":[{"s":"젓갈","tip":"멍게를 짭조름하게 삭힌 젓갈은 따뜻한 밥 위에 조금만 올려도 밥도둑이에요."}],"ri":[4]},{"n":"멍게정식","k":"멍게","ing":["멍게"],"m":"3~6","ms":"ing","ri":[7]},{"n":"물메기찜","k":"물메기","ing":["물메기"],"m":"11~2","ms":"ing","tips":[{"s":"찜","tip":"바닷바람에 꾸덕하게 말린 물메기를 쪄 먹으면 쫀득하고 감칠맛이 진해요."}],"ri":[34]},{"n":"붕장어튀김","k":"붕장어","ing":["붕장어"],"m":"6~8","ms":"ing","ri":[21]}],"ings":[{"k":"굴","label":"굴","cat":"바다","m":[1,2,3,11,12],"mt":"11~3","origin":"통영 앞바다 양식장(통영·거제 사이 바다), 강구안 일대","intro":"통영은 전국에서 손꼽히는 굴 산지라 찬바람 불면 알이 꽉 찬 굴을 회·밥·국으로 실컷 먹을 수 있어요.","src":"https://www.korea.kr/news/policyNewsView.do?newsId=148958947","styles":[{"s":"회","meal":"술","drink":"소주","tip":"갓 깐 생굴을 초고추장에 살짝 찍어 먹으면 바다 향이 입안에 확 퍼져요."},{"s":"굴밥","meal":"밥","tip":"굴을 얹어 지은 밥에 양념간장을 슥슥 비벼 먹으면 고소하고 든든해요."},{"s":"국밥","raw":"국밥(굴국)","meal":"밥","tip":"굴을 듬뿍 넣고 시원하게 끓인 국에 밥 말아 먹으면 겨울 아침 해장으로 딱이에요."},{"s":"전","meal":"술","drink":"막걸리","tip":"굴에 달걀옷을 입혀 노릇하게 부치면 겉은 고소하고 속은 촉촉해요."}]},{"k":"멍게","label":"멍게","cat":"바다","m":[3,4,5,6],"mt":"3~6","origin":"통영 연안 양식장","intro":"봄이 되면 향이 확 짙어지는 통영 멍게는 회로도, 비빔밥으로도 바다 내음이 가득해요.","src":"https://www.utour.go.kr/00152/00063/00394.web","styles":[{"s":"회","meal":"술","drink":"소주","tip":"손질한 멍게를 그대로 한 점 먹으면 쌉싸름하고 달큰한 바다 맛이 올라와요."},{"s":"비빔밥","meal":"밥","tip":"잘게 썬 멍게를 밥에 올리고 김가루, 참기름 넣어 비비면 향긋한 한 그릇이 돼요."},{"s":"젓갈","meal":"밥","tip":"멍게를 짭조름하게 삭힌 젓갈은 따뜻한 밥 위에 조금만 올려도 밥도둑이에요."}]},{"k":"멸치","label":"멸치","cat":"바다","m":[3,4,5],"mt":"3~5","origin":"통영 앞바다(남해안 기선권현망)","intro":"봄 멸치는 뼈가 연해서 회무침이나 쌈밥으로 먹으면 고소하고 새콤해요.","src":"https://www.utour.go.kr/00152/00063/00391.web","styles":[{"s":"무침","meal":"술","drink":"소주","tip":"봄 생멸치를 채소랑 새콤달콤 초장에 무쳐 먹으면 고소함이 확 살아나요."},{"s":"쌈밥","raw":"쌈밥(조림)","meal":"밥","tip":"멸치를 자작하게 조려 상추에 밥이랑 싸 먹으면 짭짤하고 든든해요."},{"s":"볶음","meal":"밥","tip":"잔멸치를 바삭하게 볶아 두면 밥반찬으로 두고두고 꺼내 먹기 좋아요."}]},{"k":"붕장어","label":"붕장어","cat":"바다","m":[6,7,8],"mt":"6~8","origin":"통영 근해","intro":"통영 사람들이 '바다장어'라 부르는 붕장어는 여름에 기름이 올라 구워 먹으면 고소함이 남달라요.","src":"https://www.utour.go.kr/00152/00063/00392.web","styles":[{"s":"구이","meal":"술","drink":"소주","tip":"양념이나 소금을 발라 숯불에 구우면 기름이 자글자글 올라 고소해요."},{"s":"탕","meal":"밥","tip":"장어를 푹 고아 시래기랑 끓인 장어탕은 진하고 구수해서 몸이 든든해져요."},{"s":"초회","raw":"초회(무침)","meal":"술","drink":"소주","tip":"얇게 썬 장어를 새콤하게 무치면 쫄깃한 식감이 살아 있어 입맛이 돌아요."}]},{"k":"갯장어","label":"갯장어","cat":"바다","m":[7,8,9],"mt":"7~9","origin":"통영 앞바다","intro":"통영에선 '하모'라고 불러요. 장마 끝나고 살이 탄탄해진 갯장어를 회나 샤브샤브로 즐기는 여름 보양식이에요.","src":"https://www.utour.go.kr/00056/00062/00119.web","styles":[{"s":"회","meal":"술","drink":"소주","tip":"잔뼈를 촘촘히 칼집 낸 하모회는 쫄깃하면서도 담백해서 여름 별미예요."},{"s":"샤브샤브","raw":"샤브샤브(탕)","meal":"둘 다","drink":"소주","tip":"뜨거운 육수에 살짝 담갔다 건지면 꽃처럼 피어나서 보는 맛, 먹는 맛이 다 있어요."}]},{"k":"도다리","label":"도다리","cat":"바다","m":[3,4],"mt":"3~4","origin":"통영 연안(자연산)","intro":"초봄 두 달 남짓, 살 오른 도다리에 해쑥을 넣고 끓인 쑥국 한 그릇이면 통영의 봄이 시작돼요.","src":"https://www.utour.go.kr/00056/00062/00119.web","styles":[{"s":"쑥국","meal":"밥","tip":"살 오른 도다리에 갓 뜯은 햇쑥을 넣고 맑게 끓이면 봄 향이 그릇 가득해요."},{"s":"회","meal":"술","drink":"소주","tip":"봄 도다리를 뼈째 얇게 썰어 먹으면 오독오독 씹히는 맛이 좋아요."}]},{"k":"전어","label":"전어","cat":"바다","m":[9,10],"mt":"9~10","origin":"통영 연안","intro":"가을 전어는 기름이 꽉 차서 뼈째 썬 회든 통구이든 씹을수록 고소해요.","src":"https://www.utour.go.kr/00056/00062/00119.web","styles":[{"s":"회","meal":"술","drink":"소주","tip":"가을 전어를 뼈째 잘게 썬 세꼬시로 먹으면 씹을수록 고소해요."},{"s":"구이","meal":"둘 다","drink":"소주","tip":"소금 뿌려 통째로 구우면 고소한 냄새가 골목까지 퍼져요."},{"s":"무침","meal":"술","drink":"막걸리","tip":"전어를 채소랑 초장에 버무리면 새콤하고 고소해서 술안주로 좋아요."}]},{"k":"물메기","label":"물메기","cat":"바다","m":[1,2,11,12],"mt":"11~2","origin":"추도(통영 물메기 주산지)","intro":"겨울 통영에선 물메기를 양념 없이 맑게 끓여 먹는데, 국물이 시원해서 해장으로 그만이에요.","src":"https://www.utour.go.kr/00056/00062/00119.web","styles":[{"s":"탕","meal":"둘 다","drink":"소주","tip":"무랑 대파만 넣고 맑게 끓인 물메기탕은 살이 부드럽고 국물이 시원해요."},{"s":"찜","meal":"술","drink":"소주","tip":"바닷바람에 꾸덕하게 말린 물메기를 쪄 먹으면 쫀득하고 감칠맛이 진해요."}]},{"k":"두릅","label":"두릅","cat":"산","m":[4,5],"mt":"4~5","origin":"통영 섬 지역(해풍 맞은 두릅)","intro":"섬 바닷바람을 맞고 자란 통영 두릅은 향이 진해서 살짝 데쳐 초고추장에 찍기만 해도 맛있어요.","src":"https://www.utour.go.kr/00152/00063/00402.web","styles":[{"s":"숙회","meal":"둘 다","drink":"막걸리","tip":"끓는 물에 살짝 데쳐 초고추장에 찍어 먹으면 쌉싸름한 봄 향이 좋아요."},{"s":"튀김","meal":"술","drink":"막걸리","tip":"얇게 튀김옷을 입혀 바삭하게 튀기면 쌉쌀한 맛이 순해져서 먹기 좋아요."},{"s":"무침","meal":"밥","tip":"데친 두릅을 양념에 조물조물 무쳐 두면 봄 밥반찬으로 그만이에요."}]}],"rest":[{"n":"향토집","a":"통영시 무전5길 37-41 (무전동)","st":["회","전"],"sx":"굴 요리(회·찜·전 등)","why":"통영U투어 음식점 소개 페이지에 「굴 요리 전문점」 메뉴로 소개된 집","src":"https://www.utour.go.kr/00056/00062/00143.web?amode=view&idx=2779","ok":"일치(영업 중)","c":"2026-10","d":1,"f":"굴"},{"n":"통영굴마당","a":"통영시 도남로 257-81 (도남동)","st":["굴 요리"],"sx":"굴 요리","why":"통영U투어 음식점 소개 페이지에 「굴 요리 전문점」 메뉴로 소개된 집","src":"https://www.utour.go.kr/00056/00062/00143.web?amode=view&idx=3075","ok":"일치(영업 중)","c":"2026-10","d":1,"f":"굴"},{"n":"