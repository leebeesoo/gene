{"id":"yeongdeok","name":"영덕","sido":"경상북도","sigungu":"영덕군","checked":"2026-10","dishes":[{"n":"영덕대게찜","k":"영덕대게","ing":["영덕대게"],"m":"11~5","ms":"ing","tips":[{"s":"찜","tip":"통째로 쪄서 다리 살을 쭉 빼 먹고, 마지막엔 등딱지에 밥을 비벼 먹어요."}],"ri":[0,1,2,3,4,5,6,7]},{"n":"미주구리 회","alt":["물가자미"],"k":"물가자미","ing":["물가자미(미주구리)"],"m":"4~5","ms":"dish","season":"봄(4~5월) 기름가자미 제철","intro":"뼈째 썰어 내는 가자미 회예요. 무침이나 물회로도 먹어요.","src":"https://yeongdeok.grandculture.net/yeongdeok/toc/GC08501146","tips":[{"s":"회","tip":"뼈가 연해서 뼈째 잘게 썰어 초장이나 막장에 찍어 먹어요."}],"ri":[7,8,9,10]},{"n":"물가자미구이","k":"물가자미","ing":["물가자미(미주구리)"],"m":"4~5","ms":"ing","tips":[{"s":"구이","tip":"꾸덕하게 말린 걸 구우면 고소함이 확 살아나요."}],"ri":[8,9,10]},{"n":"붉은대게찜","k":"붉은대게","ing":["붉은대게(홍게)"],"m":"12~5","ms":"ing","tips":[{"s":"찜","tip":"대게보다 값이 착해서 넉넉히 쪄 먹기 좋아요. 살이 달큰해요."}],"ri":[3]},{"n":"황금은어탕","k":"황금은어","ing":["황금은어"],"m":"7~9","ms":"ing","ri":[11]}],"ings":[{"k":"영덕대게","label":"영덕대게","cat":"바다","m":[1,2,3,4,5,11,12],"mt":"11~5","origin":"강구면·축산면 앞바다(강구항·축산항)","intro":"다리가 길쭉하고 속살이 꽉 차서 담백하고 쫄깃해요. 봄 직전이 제일 맛있어요.","src":"https://yeongdeok.grandculture.net/yeongdeok/toc/GC08500975","styles":[{"s":"찜","meal":"둘 다","tip":"통째로 쪄서 다리 살을 쭉 빼 먹고, 마지막엔 등딱지에 밥을 비벼 먹어요."},{"s":"라면","raw":"라면(탕)","meal":"둘 다","tip":"대게를 먹고 남은 껍데기와 살로 라면을 끓이면 국물이 시원해요."}]},{"k":"붉은대게","label":"붉은대게(홍게)","cat":"바다","m":[1,2,3,4,5,12],"mt":"12~5","origin":"강구면 강구항(가공 공장)","intro":"대게보다 값이 착하고 살이 달큰해요. 게살·게장으로도 많이 만들어요.","src":"https://yeongdeok.grandculture.net/yeongdeok/toc/GC08500974","styles":[{"s":"찜","meal":"둘 다","tip":"대게보다 값이 착해서 넉넉히 쪄 먹기 좋아요. 살이 달큰해요."},{"s":"게장·게살","meal":"밥","tip":"게살을 발라 밥에 비벼 먹거나 게장으로 밥 한 그릇 뚝딱해요."}]},{"k":"물가자미","label":"물가자미(미주구리)","cat":"바다","m":[4,5],"mt":"4~5","origin":"축산면 축산항","intro":"살이 보드랍고 뼈가 연해서 뼈째 썰어 먹어요. 영덕 사람들이 대게보다 자주 먹는 생선이에요.","src":"https://yeongdeok.grandculture.net/yeongdeok/toc/GC08501146","styles":[{"s":"회","raw":"회(뼈째)","meal":"술","tip":"뼈가 연해서 뼈째 잘게 썰어 초장이나 막장에 찍어 먹어요."},{"s":"물회","meal":"밥","tip":"채소랑 회를 얼음 육수에 말아 시원하게 훌훌 먹어요."},{"s":"식해","meal":"밥","tip":"말린 가자미를 조밥·고춧가루·엿기름에 버무려 삭혀요. 새콤매콤해서 밥도둑이에요."},{"s":"구이","meal":"둘 다","tip":"꾸덕하게 말린 걸 구우면 고소함이 확 살아나요."}]},{"k":"도다리","label":"도다리","cat":"바다","m":[3,4,5],"mt":"3~5","origin":"축산면·강구면 연안","intro":"거의 다 자연산이라 봄에 잡히는 게 귀해요. 가자미랑 꼭 닮았어요.","src":"https://yeongdeok.grandculture.net/yeongdeok/toc/GC08500977","styles":[{"s":"회","meal":"술","tip":"봄 도다리는 살이 차지니 회로 먹어요."}]},{"k":"오징어","label":"오징어","cat":"바다","m":[6,7,8,9],"mt":"6~9","origin":"영덕 앞바다(강구·축산 등)","intro":"여름밤 바다를 환하게 밝힌 오징어배가 영덕 풍경이에요. 해풍에 말리면 맛이 더 진해져요.","src":"https://yeongdeok.grandculture.net/yeongdeok/toc/GC08500297","styles":[{"s":"회","meal":"술","tip":"갓 잡은 걸 가늘게 썰어 초장에 찍어 먹어요."},{"s":"반건조 구이","raw":"반건조 구이(피데기)","meal":"술","tip":"반쯤 말린 피데기를 구우면 쫀득하고 달아요."},{"s":"볶음","meal":"밥","tip":"매콤하게 볶아 밥에 얹어 먹어요."}]},{"k":"돌미역","label":"돌미역","cat":"바다","m":[4,5],"mt":"4~5","origin":"영덕읍 창포리·강구면·축산면·병곡면 연안","intro":"파도 센 갯바위에서 겨우내 자라 봄에 따요. 바닷바람에 말려서 팔아요.","src":"https://yeongdeok.grandculture.net/yeongdeok/toc/GC08501369","styles":[{"s":"국","meal":"밥","tip":"오래 끓일수록 국물이 뽀얗고 진해져요."}]},{"k":"황금은어","label":"황금은어","cat":"민물","m":[7,8,9],"mt":"7~9","origin":"영덕읍 오십천·송천","intro":"아가미 아래 금빛 띠가 있는 은어예요. 살에서 수박 같은 향이 나요. 옛날엔 임금님께 올렸대요.","src":"https://yeongdeok.grandculture.net/yeongdeok/toc/GC08500296","styles":[{"s":"회","meal":"술","tip":"수박 향이 나는 살을 회로 먹어요."},{"s":"훈제","meal":"술","tip":"훈제한 은어는 오래 두고 먹을 수 있어요."}]},{"k":"송이","label":"송이","cat":"산","m":[9,10],"mt":"9~10","origin":"맹동산·동대산 등 영덕 전역 산지","intro":"향이 진하고 쫄깃해요. 영덕이 전국에서 송이를 제일 많이 내요.","src":"https://yeongdeok.grandculture.net/yeongdeok/toc/GC08500980","styles":[{"s":"구이","meal":"술","tip":"얇게 찢어 살짝만 구워 소금장에 찍어 먹어요. 향이 날아가지 않게 짧게 구워요."},{"s":"생으로","meal":"술","tip":"좋은 송이는 결대로 찢어 날로 먹어도 향이 좋아요."}]},{"k":"복숭아","label":"복숭아","cat":"밭","m":[7,8,9],"mt":"7~9","origin":"영덕읍 화개리 등 오십천 유역, 강구면","intro":"볕은 많고 비는 적은 모래땅에서 자라 달고 과육이 단단해요.","src":"https://yeongdeok.grandculture.net/yeongdeok/toc/GC08500981","styles":[{"s":"생과","meal":"둘 다","tip":"차게 해 두었다가 껍질째 한입 크게 베어 먹어요."}]},{"k":"사과","label":"사과","cat":"밭","m":[9,10,11],"mt":"9~11","origin":"창수면 등 해발 200~240m 고지대","intro":"높은 데서 햇볕을 듬뿍 받아 알이 크고 달아요. 대게 껍데기를 거름으로 써요.","src":"https://yeongdeok.grandculture.net/yeongdeok/toc/GC08500979","styles":[{"s":"생과","meal":"둘 다","tip":"껍질째 아삭하게 먹어요."}]}],"rest":[{"n":"고래불회대게","a":"영덕군 병곡면 병곡1길 110, 2층","st":["찜"],"sx":"찜, 회","why":"영덕문화관광재단 스테이영덕 맛집 목록 고래불 대게·회 식당","src":"https://ydstay.kr/stay/detail?category=R&category2=영덕&id=168","ok":"일치(영업 중)","c":"2026-10","d":1,"f":"영덕대게"},{"n":"축산항 대게궁 영덕대게","a":"영덕군 축산면 축산항길 85, 3층","st":["찜"],"sx":"찜","why":"영덕문화관광재단 스테이영덕 맛집 목록 축산항 대게 식당","src":"https://ydstay.kr/stay/detail?category=R&category2=영덕&id=172","ok":"일치(영업 중)","c":"2026-10","d":1,"f":"영덕대게"},{"n":"청정대게,회","a":"영덕군 강구면 신강구길 80","st":["찜"],"sx":"찜, 회","why":"영덕문화관광재단 스테이영덕 맛집 목록 강구 대게·회 식당","src":"https://ydstay.kr/stay/detail?category=R&category2=영덕&id=186","ok":"일치(영업 중)","c":"2026-10","d":1,"f":"영덕대게"},{"n":"한바다대게회","a":"영덕군 강구면 신강구길 86","st":["찜"],"sx":"찜","why":"영덕문화관광재단 스테이영덕 맛집 목록 강구 박달대게·홍게 식당","src":"https://ydstay.kr/stay/detail?category=R&category2=영덕&id=188","ok":"일치(영업 중)","c":"2026-10","d":1,"f":"영덕대게·붉은대게(홍게)"},{"n":"귀빈대게회타운","a":"영덕군 강구면 영덕대게로 207","st":["찜"],"sx":"찜, 탕","why":"영덕문화관광재단 스테이영덕 맛집 목록 강구 대게 요리·대게라면탕 식당","src":"https://ydstay.kr/stay/detail?category=R&category2=영덕&id=85","ok":"일치(영업 중)","c":"2026-10","d":1,"f":"영덕대게"},{"n":"영덕대게 맛집 이가대게","a":"영덕군 강구면 강구대게길 52","st":["찜"],"sx":"찜","why":"영덕문화관광재단 스테이영덕 맛집 목록 강구 대게 식당","src":"https://ydstay.kr/stay/detail?category=R&category2=영덕&id=101","ok":"일치(영업 중)","c":"2026-10","d":1,"f":"영덕대게"},{"n":"해상회식당","a":"영덕군 강구면 해상공원길 85","st":["찜"],"sx":"찜, 회","why":"영덕문화관광재단 스테이영덕 맛집 목록 강구 대게+회 세트 식당","src":"https://ydstay.kr/stay/detail?category=R&category2=영덕&id=103","ok":"일치(영업 중)","c":"2026-10","d":1,"f":"영덕대게"},{"n":"신 마창수산","a":"영덕군 강구면 영덕대게로 113-1, 1~2층","st":["찜","회"],"sx":"찜","why":"영덕문화관광재단 스테이영덕 맛집 목록 강구 대게·물가자미 식당","src":"https://y