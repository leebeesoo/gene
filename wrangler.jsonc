// 재미랩 사이트 전체를 Cloudflare Workers(정적 파일)로 배포하는 설정.
// Cloudflare 빌드 설정: Build command = node tools/seo/build.mjs, Deploy command = npx wrangler deploy
// name은 Cloudflare에 만든 Worker 이름과 같아야 한다.
{
  "name": "gene",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
